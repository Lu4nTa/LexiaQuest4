; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lexia Quest"
run/main_scene="res://levels/StartScreen/StartScreen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/Tchad/Base Art/Tchad_Base.png"
config/windows_native_icon="res://icon.ico"

[autoload]

MatchImageDB="*res://assets/Database/Match-Image.gd"
RhymesWithDB="*res://assets/Database/Rhymes-With.gd"
StartsWithDB="*res://assets/Database/Starts-With.gd"
SoundBingoDB="*res://assets/Database/Sound-Bingo.gd"
WordSearchDB="*res://assets/Database/Word-Search.gd"
SyllableBlendDB="*res://assets/Database/Syllable-Blend.gd"
CustomChoiceDB="*res://assets/Database/Custom-Choice.gd"
AudioSequenceDB="*res://assets/Database/Audio-Sequence.gd"
RhymesWithImageDB="*res://assets/Database/Rhymes-With-Image.gd"
AllDB="*res://assets/Database/All.gd"
QuizGenerator="*res://quizzes/QuizGenerator.gd"
WordAudio="*res://autoloads/WordAudio.gd"
QuizKeyboardNav="*res://autoloads/QuizKeyboardNav.gd"
Rewards="*res://autoloads/Rewards.gd"

[display]

window/stretch/mode="canvas_items"
window/size/width=1280
window/size/height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/adbox/plugin.cfg")

